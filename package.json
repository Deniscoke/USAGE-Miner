{
  "name": "usage-miner",
  "version": "0.1.0",
  "private": true,
  "description": "USAGE Miner \u2014 routes your AI tools through USAGE so their compute can be verified.",
  "type": "module",
  "bin": {
    "usage": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "package": "node scripts/package.mjs",
    "dev": "node --import tsx src/cli.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "tsx": "^4.23.13",
    "typescript": "^5",
    "vitest": "^5.0.0"
  }
}
