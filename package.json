{
  "name": "usage-miner",
  "version": "0.4.0",
  "private": true,
  "description": "USAGE Miner -- routes your AI tools through USAGE so their compute can be verified. Windows.",
  "type": "module",
  "bin": {
    "usage": "./dist/app.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "package": "node scripts/package.mjs --with-installer",
    "dev": "node --import tsx src/cli.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "esbuild": "^0.28.2",
    "postject": "^1.0.0-alpha.6",
    "tsx": "^4.23.13",
    "typescript": "^5",
    "vitest": "^5.0.0",
    "rcedit": "^5.0.2"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/Deniscoke/USAGE-Miner"
  }
}
